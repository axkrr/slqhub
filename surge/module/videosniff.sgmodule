[Script]
senplayer-video-sniff = type=http-response,pattern=\.(m3u8|mp4),requires-body=0,script-path=https://raw.githubusercontent.com/axkrr/slqhub/main/js/videosniff.js

[MITM]
hostname = %APPEND% *.phncdn.com, *.cloudfront.net, *.txh*.com, long.*.cn, surrit.com, *.aisheji8.com
