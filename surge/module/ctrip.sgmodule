#!name=携程旅行ck
#!desc=登陆"携程旅行"微信小程序可获取账号授权，填写模块参数可禁用脚本。
#!category=cookie
#!author=NobyDa
#!icon=https://raw.githubusercontent.com/axkrr/slqhub/main/icon/xclx.png
#!update=2026-08-08
#!arguments=禁用脚本:携程旅行[授权],禁用MITM:hostname
#!arguments-desc=禁用脚本：禁用获取授权脚本，输入 # 表示禁用。\n\n禁用MITM：禁用MITM主机名，输入 # 表示禁用。

[Script]
{{{禁用脚本}}} = type=http-response,pattern=^https:\/\/m\.ctrip\.com\/restapi\/soa2\/\d+\/[a-zA-Z]+Login(?:$|\?),requires-body=1,max-size=0,debug=0,script-path=https://raw.githubusercontent.com/NobyDa/Script/master/Ctrip-DailyBonus/Ctrip.js

[MITM]
{{{禁用MITM}}} = %APPEND% m.ctrip.com