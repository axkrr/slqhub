[Script]
一卡通Token捕获 = type=http-response, pattern=http:\/\/payment\.cqu\.edu\.cn\/berserker-auth\/oauth\/token, script-path=https://raw.githubusercontent.com/axkrr/slqhub/main/js/balance.js, requires-body=1, max-size=8192, script-update-interval=0

[MITM]
hostname = %APPEND% payment.cqu.edu.cn
