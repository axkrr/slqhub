[Script]
jd_price_res = type=http-response, pattern=^https?:\/\/in\.m\.jd\.com\/product\/graphext\/\d+\.html, requires-body=1, max-size=0, script-path=https://raw.githubusercontent.com/wf021325/qx/master/js/jd_price.js
jd_price_req = type=http-request, pattern=^https?:\/\/apapia-sqk-weblogic\.manmanbuy\.com\/baoliao\/center\/menu$, requires-body=1, max-size=0, script-path=https://raw.githubusercontent.com/wf021325/qx/master/js/jd_price.js

