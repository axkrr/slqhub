#!name=BiliBili每日等级任务
#!desc=定时任务及Cookie获取
#!author= MartinsKin
#!category= cookie
#!icon=https://raw.githubusercontent.com/ClydeTime/BiliBili/main/database/icon_Avatar.png
#!update=2025-05-15
#!arguments = script_QrCode:B站Cookie(扫码),script_APP:B站Cookie(APP)
# 使用APP获取cookie,保持B站Cookie(APP)开启,如检测到cookie变更会自动更新,解决cookie经常过期的问题
# 使用扫码获取cookie,保持B站Cookie(扫码)开启,打开APP后,根据推送提示操作获取cookie
# 用户可选择自行开启或关闭,两种获取方式不可兼用,如需关闭,点击模块右侧三个点或长按模块,选择编辑参数,将script_QrCode或script_APP设置为#即可
# 任务奖励：经验值/硬币/大会员积分/年度会员领取B币等
# 订阅地址：https://raw.githubusercontent.com/ClydeTime/BiliBili/main/boxjs/BiliBili.boxjs.json

[Script]
{{{script_QrCode}}} = type=http-response,pattern=^https?:\/\/app\.bilibili\.com\/x\/resource\/fingerprint\?,script-path=https://raw.githubusercontent.com/ClydeTime/BiliBili/main/js/BiliBiliDailyBonus.js,requires-body=0,timeout=30
{{{script_APP}}} = type=http-request,pattern=^https?:\/\/app\.bilibili\.com\/x\/resource\/fingerprint\?,script-path=https://raw.githubusercontent.com/ClydeTime/BiliBili/main/js/BiliBiliDailyBonus.js,requires-body=0

[MITM]
hostname = %APPEND% app.bilibili.com