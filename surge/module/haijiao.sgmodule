^https?:\/\/api-dc-prod-002\.cyou\/ - reject
^https?:\/\/api-dc2-prod-02\.cyou\/ - reject

[Script]
hjsq-noad = type=http-response, pattern=^https?:\/\/api2\.[^\/]+\/api\/, script-path=https://raw.githubusercontent.com/89996462/Quantumult-X/main/ghs/hjsq-noad.js, requires-body=true, max-size=-1, timeout=60

hdsq = type=http-request, pattern=^https:\/\/[^\/]*\..*\.cn\/\w+\/[a-z0-9]{32}\/[a-z0-9]{32}\.m3u8(\?.*)?, script-path=https://raw.githubusercontent.com/89996462/Quantumult-X/main/ghs/hdsq.js, timeout=60

[MITM]
hostname = %APPEND% p4.aozngkwm.com, *.aozngkwm.com, api2.anpbbxdyo.com, *.anpbbxdyo.com, new.iajckz.cn, *.iajckz.cn, *.aavhnube.cc