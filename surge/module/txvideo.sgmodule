#!name=腾讯视频
#!desc=去除开屏/播放广告;精简底栏与个人中心
#!category=axkrr
#!author=@ZenMoFiShi,@axkrr
#!icon=https://raw.githubusercontent.com/axkrr/slqhub/main/icon/adblocker.png
#!update=2026-11-01

[Rule]
DOMAIN,iacc.stgw.qq.com,REJECT
DOMAIN,tacc.video.qq.com,REJECT

[Script]
腾讯视频请求净化 = type=http-request, pattern=^https?:\/\/i\.video\.qq\.com\/(?:\?.*)?$, requires-body=true, binary-body-mode=true, timeout=20, script-path=https://raw.githubusercontent.com/axkrr/slqhub/main/js/txvideo.js
腾讯视频响应净化 = type=http-response, pattern=^https?:\/\/i\.video\.qq\.com\/(?:\?.*)?$, requires-body=true, binary-body-mode=true, timeout=20, script-path=https://raw.githubusercontent.com/axkrr/slqhub/main/js/txvideo.js
腾讯视频播放净化 = type=http-response, pattern=^https?:\/\/iacc\.qq\.com\/(?:\?.*)?$, requires-body=true, binary-body-mode=true, timeout=20, script-path=https://raw.githubusercontent.com/axkrr/slqhub/main/js/txvideo.js
腾讯视频底栏净化 = type=http-response, pattern=^https?:\/\/config\.ab\.qq\.com\/tab\/GetTabRemoteConfig(?:\?.*)?$, requires-body=true, binary-body-mode=true, timeout=20, script-path=https://raw.githubusercontent.com/axkrr/slqhub/main/js/txvideo.js
腾讯视频灰度配置 = type=http-response, pattern=^https:\/\/rdelivery\.qq\.com\/v1\/sdkconfig\/get(?:\?.*)?$, requires-body=true, timeout=20, script-path=https://raw.githubusercontent.com/axkrr/slqhub/main/js/txvideo.js

[MITM]
hostname = %APPEND% i.video.qq.com, iacc.qq.com, config.ab.qq.com, rdelivery.qq.com
