#!name=Dilkan净化
#!desc=去除iOS端广告并拦截统计上报
#!category=axkrr
#!author=axkrr
#!icon=https://raw.githubusercontent.com/axkrr/slqhub/main/icon/dilkan.png
#!update=2026-11-28

[Script]
dilkan_clean_detail = type=http-response,pattern=^https?:\/\/api\.dilkan\.com\.cn\/apiv3_0\/dilkan\/ios\/movie2_detail,script-path=https://raw.githubusercontent.com/axkrr/slqhub/main/js/dilkan_pure.js,requires-body=1,max-size=4194304
dilkan_clean_home = type=http-response,pattern=^https?:\/\/api\.dilkan\.com\.cn\/apiv3_0\/dilkan\/ios\/movie2_home2,script-path=https://raw.githubusercontent.com/axkrr/slqhub/main/js/dilkan_pure.js,requires-body=1,max-size=4194304
dilkan_clean_goods = type=http-response,pattern=^https?:\/\/api\.dilkan\.com\.cn\/apiv3_0\/dilkan\/ios\/movie2_goods,script-path=https://raw.githubusercontent.com/axkrr/slqhub/main/js/dilkan_pure.js,requires-body=1,max-size=4194304
dilkan_clean_elan = type=http-response,pattern=^https?:\/\/api\.dilkan\.com\.cn\/apiv3_0\/dilkan\/ios\/elan_info_v0,script-path=https://raw.githubusercontent.com/axkrr/slqhub/main/js/dilkan_pure.js,requires-body=1,max-size=4194304
dilkan_clean_hist = type=http-response,pattern=^https?:\/\/api\.dilkan\.com\.cn\/apiv3_0\/dilkan\/ios\/history_movie_list,script-path=https://raw.githubusercontent.com/axkrr/slqhub/main/js/dilkan_pure.js,requires-body=1,max-size=4194304
dilkan_block = type=http-request,pattern=^https?:\/\/(?:[a-z0-9-]+\.)?(?:umeng\.com|jpush\.cn|oceanengine\.com|bdurl\.net)\/,script-path=https://raw.githubusercontent.com/axkrr/slqhub/main/js/dilkan_pure.js,max-size=65536

[MITM]
hostname = %APPEND% api.dilkan.com.cn, api.ulunix.cn, *.umeng.com, *.jpush.cn, analytics.oceanengine.com, dig.bdurl.net