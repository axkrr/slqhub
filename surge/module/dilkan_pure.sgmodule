

#!name=Dilkan净化
#!desc=去除iOS端开屏、会员页推广与弹窗广告
#!category=axkrr
#!author=axkrr
#!icon=https://raw.githubusercontent.com/axkrr/slqhub/main/icon/dilkan.png
#!update=2026-11-27

[Script]
dilkan_clean = type=http-response,pattern=^https?:\/\/api\.(?:dilkan\.com\.cn|ulunix\.cn)\/apiv[0-9_]+\/(?:[0-9]+\/)*dilkan\/(?:ios\/)?(?:movie2_home2|movie2_goods|elan_info_v0|history_movie_list),script-path=https://raw.githubusercontent.com/axkrr/slqhub/main/js/dilkan_pure.js,requires-body=1,max-size=2097152

[MITM]
hostname = %APPEND% api.dilkan.com.cn, api.ulunix.cn