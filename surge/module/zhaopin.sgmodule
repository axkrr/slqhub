[Rule]
DOMAIN-SUFFIX,sofire.baidu.com,REJECT
URL-REGEX,^https?://cgate\.zhaopin\.com/operation/ad/(getAdRecommend|bidMainPage),REJECT
URL-REGEX,^https?://cgate\.zhaopin\.com/campusbusiness/operation-ad-slot/getAdvertisement,REJECT
URL-REGEX,^https?://cgate\.zhaopin\.com/bdp/operation/getPopupInfo,REJECT
URL-REGEX,^https?://cgate\.zhaopin\.com/bdp/tips-calc/getSchoolHomePageTips,REJECT
DOMAIN-SUFFIX,ido.gepush.com,REJECT
DOMAIN-SUFFIX,mpush-api.aliyun.com,REJECT
DOMAIN-SUFFIX,ds.zhaopin.cn,REJECT
URL-REGEX,^https?://cgate\.zhaopin\.com/userpassport/report/reportShuMeiDevice,REJECT
URL-REGEX,^https?://cgate\.zhaopin\.com/userpassport/userV2/appStartupReport,REJECT
URL-REGEX,^https?://cgate\.zhaopin\.com/bdp/configManager/reportLogState,REJECT
URL-REGEX,^https?://cgate\.zhaopin\.com/cother/appLocalLog/getUploadConfig,REJECT
URL-REGEX,^https?://ask\.zhaopin\.com/plat-zqa-server/eventtracking,REJECT
DOMAIN-SUFFIX,statistic.live.126.net,REJECT
DOMAIN-SUFFIX,abt-online.netease.im,REJECT
URL-REGEX,^https?://api\.map\.baidu\.com/sdkcs/verify,REJECT

[Script]
zhaopin = type=http-response,pattern=^https?:\/\/capi\.zhaopin\.com\/capi\/commercialize\/getConfig,requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/axkrr/slqhub/main/js/zlzp.js

[MITM]
hostname = %APPEND% capi.zhaopin.com
