[Script]
zlzp = type=http-response,pattern=^https?:\/\/cgate\.zhaopin\.com\/(operation\/ad\/(bidMainPage|getAdRecommend)|bdp\/operation\/getPopupInfo),requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/axkrr/slqhub/main/js/zlzp.js
^https?:\/\/.*\.pangolin-sdk-toutiao\d*\.com - reject-dict
^https?:\/\/.*\.pglstatp-toutiao\.com - reject-dict
^https?:\/\/gromore\.pangolin-sdk-toutiao\.com - reject-dict

[MITM]
hostname = %APPEND% cgate.zhaopin.com, *.pangolin-sdk-toutiao*.com, *.pglstatp-toutiao.com
