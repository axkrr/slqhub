#!name=黑料网
#!desc=网页净化
#!category=axkrr
#!author=@ZenMoFiShi
#!update=2026-05-18

[Script]
hlw = type=http-response, pattern=^https?:\/\/(?:www\.)?(?:heiliao|hlwxx|hlcx\d*)\.com\/(?!static\/|favicon|api\/|index\/statistics|uploads\/), requires-body=1, max-size=0, script-path=https://raw.githubusercontent.com/ZenmoFeiShi/Qx/refs/heads/main/hlwxx_remove_ads.js

[URL Rewrite]
^https?:\/\/stats\.kwvprfcr\.xyz - reject
^https?:\/\/mc\.yandex\.ru - reject
^https?:\/\/api1\.cghhqca\.cc\/api\/eventTracking - reject-dict

[MITM]
hostname = %APPEND% *heiliao*, *hlwxx*, *hlcx*, stats.kwvprfcr.xyz, mc.yandex.ru, api1.cghhqca.cc
