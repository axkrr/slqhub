[rewrite_local]
# 去哒 App 开屏 / 首页广告（JSON 类）
^https?:\/\/.*\/(openAds|startPage|advertisement|ad_list|ads|items|banners).* url script-response-body https://raw.githubusercontent.com/axkrr/slqhub-entry/main/qdpure.js

# 去哒 图片类广告（仅广告路径，避免影响正常图片）
^https?:\/\/p0\.meituan\.net\/bizad\/.* url reject
^https?:\/\/static\.66mobi\.com\/creativeAudit\/.* url reject
^https?:\/\/qudaapi\.8quan\.com\/index\/source\/show\?filepath=.*advertisement.* url reject

[mitm]
hostname = %APPEND% p0.meituan.net, static.66mobi.com, qudaapi.8quan.com