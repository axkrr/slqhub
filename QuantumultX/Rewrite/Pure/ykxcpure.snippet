#-----------------------------------------
# name: yike_ads_clean
# desc: 一刻相册全广告净化（开屏加速+信息流+无占位）
# author: axkrr
#-----------------------------------------

[rewrite]

^https?:\/\/pan\.baidu\.com\/rest\/2\.0\/pcs\/(adv|ad).* url script-response-body https://raw.githubusercontent.com/axkrr/slqhub-entry/main/ykxcpure.js

^https?:\/\/pan\.baidu\.com\/rest\/2\.0\/xpan\/(nas|feed|smartprogram|activityentry).* url script-response-body https://raw.githubusercontent.com/axkrr/slqhub-entry/main/ykxcpure.js

^https?:\/\/pan\.baidu\.com\/(act\/v2\/homepage|act\/v2\/album|act\/v2\/|rest\/2\.0\/pcs\/banner).* url script-response-body https://raw.githubusercontent.com/axkrr/slqhub-entry/main/ykxcpure.js


; SDK兜底（防漏）
^https?:\/\/(mobads|als|sofire|afd|afdconf)\.baidu\.com\/.* url reject-200
^https?:\/\/api-access\.pangolin-sdk-toutiao\d*\.com\/.* url reject-200
^https?:\/\/sf\d+-fe-tos\.pglstatp-toutiao\.com\/.* url reject-200
^https?:\/\/v2mi\.gdt\.qq\.com\/.* url reject-200
^https?:\/\/(sdk|api-htp)\.beizi\.biz\/.* url reject-200
^https?:\/\/sdk(-cfg)?\.adx\.adwangmai\.com\/.* url reject-200
^https?:\/\/sdk(log)?\.zhangyuyidong\.cn\/.* url reject-200

; 上报
^https?:\/\/toblog\.ctobsnssdk\.com\/.* url reject
^https?:\/\/.*\/(ad\/log|advert\/report|track\/ad).* url reject


[mitm]
hostname = %APPEND% pan.baidu.com, mobads.baidu.com, als.baidu.com, sofire.baidu.com, afd.baidu.com, afdconf.baidu.com, api-access.pangolin-sdk-toutiao.com, api-access.pangolin-sdk-toutiao1.com, sf3-fe-tos.pglstatp-toutiao.com, sf6-fe-tos.pglstatp-toutiao.com, v2mi.gdt.qq.com, sdk.beizi.biz, api-htp.beizi.biz, sdk.adx.adwangmai.com, sdk-cfg.adx.adwangmai.com, sdk.zhangyuyidong.cn, sdklog.zhangyuyidong.cn, toblog.ctobsnssdk.com