# SenPlayer Video Sniff (QX)
# 嗅探 m3u8 / mp4 并跳转 SenPlayer

[rewrite]
^https?:\/\/.*\.(m3u8|mp4)(\?.*)?$ url script-request https://raw.githubusercontent.com/axkrr/slqhub/main/QuantumultX/Rewrite/Tool/videosniff.js

[mitm]
hostname = %APPEND% *.phncdn.com, *.cloudfront.net, www.pornhub.com, cn.pornhub.com