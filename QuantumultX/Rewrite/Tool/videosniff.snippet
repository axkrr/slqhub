# SenPlayer Video Sniff (QX)
# 嗅探 m3u8 / mp4 并跳转 SenPlayer
# videosniff.js 位于私有仓库 slqhub

[rewrite]
^https?:\/\/.*\.(m3u8|mp4)(\?.*)?$ url script-response-body https://raw.githubusercontent.com/axkrr/slqhub-entry/main/videosniff.js requires-body=1

[mitm]
hostname = %APPEND% *.phncdn.com, *.cloudfront.net, www.pornhub.com, cn.pornhub.com, txh066.com, txh067.com, p3.unpljks.top, long.gfuhubh.cn