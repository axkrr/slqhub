# Name: wyycrack
# Update: 2025-12-19

[rewrite]
# 解锁会员皮肤、歌曲详情及播放权限
^https:\/\/interface3?\.music\.163\.com\/eapi\/(playermode\/|v3\/song\/detail|song\/(chorus|enhance\/|play\/|type\/detail\/get)|v1\/artist\/top\/song|v3\/discovery\/recommend\/songs) url script-request-body https://raw.githubusercontent.com/BOBOLAOSHIV587/Rules/main/JS/NeteaseCloudMusic/JS/JS-5/NeteaseCloud.js

# 搜索结果与首页歌单会员内容
^https?:\/\/interface3?\.music\.163\.com\/eapi\/(search\/complex\/(page|rec\/song\/get)|(homepage\/|v6\/)?playlist\/) url script-request-body https://raw.githubusercontent.com/BOBOLAOSHIV587/Rules/main/JS/NeteaseCloudMusic/JS/JS-5/NeteaseCloud.js

# 会员认证与侧边栏等级显示
^https?:\/\/interface3?\.music\.163\.com\/eapi\/(vipnewcenter\/app\/resource\/newaccountpage|vipauth\/app\/auth\/(soundquality\/)?query) url script-request-body https://raw.githubusercontent.com/BOBOLAOSHIV587/Rules/main/JS/NeteaseCloudMusic/JS/JS-5/NeteaseCloud.js

[mitm]
hostname = %APPEND% interface*.music.163.com
