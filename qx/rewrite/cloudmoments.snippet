#-----------------------------------------
# name: CloudMoments
# desc: 一刻相册净化
# author: axkrr
#-----------------------------------------
# > 一刻相册 - 脚本处理 (核心业务+首页Banner)
^https?:\/\/yike\.baidu\.com\/api\/(operation\/(splash|banner)|config) url script-response-body https://raw.githubusercontent.com/axkrr/slqhub-entry/main/ykxcpure.js
^https?:\/\/pan\.baidu\.com\/api\/user\/privilege url script-response-body https://raw.githubusercontent.com/axkrr/slqhub-entry/main/ykxcpure.js

# > 百度 SDK 阻断 (关键：解决“等待几秒”的卡顿感)
^https?:\/\/mobads\.baidu\.com url reject-200
^https?:\/\/mobads-logs\.baidu\.com url reject-200
^https?:\/\/wn\.pos\.baidu\.com url reject-200
^https?:\/\/duclick\.baidu\.com url reject-200

hostname = yike.baidu.com, pan.baidu.com, mobads.baidu.com, mobads-logs.baidu.com, wn.pos.baidu.com
