[rewrite]
^https?:\/\/api\.anythinktech\.com\/v\d\/open\/placement url script-response-body https://raw.githubusercontent.com/axkrr/slqhub-entry/main/123panpure.js

^https?:\/\/adx-.*\.anythinktech\.com\/(bid|request) url script-response-body https://raw.githubusercontent.com/axkrr/slqhub-entry/main/123panpure.js

^https?:\/\/api\.shanghailingye\.cn\/ad\/map url script-response-body https://raw.githubusercontent.com/axkrr/slqhub-entry/main/123panpure.js

^https?:\/\/sdkquic\.e\.qq\.com\/launch url reject-200

[mitm]
hostname = %APPEND% api.anythinktech.com, adx-*.anythinktech.com, api.shanghailingye.cn, sdkquic.e.qq.com, log-api.pangolin-sdk-toutiao-b.com, sdk.beizi.biz
