[general]
server_check_url=http://www.google.com/generate_204
server_check_timeout = 3000
dns_exclusion_list=*.cmpassport.com, *.jegotrip.com.cn, *.icitymobile.mobi, id6.me, *.pingan.com.cn, *.cmbchina.com
;geo_location_checker=http://ip-api.com/json/?lang=en-US, https://raw.githubusercontent.com/fmz200/wool_scripts/main/QuantumultX/scripts/server_location.js
resource_parser_url=https://raw.githubusercontent.com/KOP-XIAO/QuantumultX/master/Scripts/resource-parser.js
excluded_routes=239.255.255.250/32
fallback_udp_policy=direct
# UDP 白名单：留空则默认所有为端口。不在udp白名单列表中的端口，将被丢弃处理（返回 ICMP “端口不可达” 信息）。
;udp_whitelist=1-442, 444-65535
udp_drop_list=443
# geolite2
#https://raw.githubusercontent.com/Loyalsoldier/geoip/release/Country.mmdb
# =====================================
[dns]
;prefer-doh3
;doh-server=https://223.5.5.5/dns-query, https://223.6.6.6/dns-query
no-system
;no-ipv6
server=223.5.5.5
server=119.29.29.29
server=8.8.8.8
server=/*.icloud.com/119.29.29.29
server=/*.icloud.com.cn/119.29.29.29
server=/*.tencent.com/119.29.29.29
server=/*.weixin.com/119.29.29.29
server=/miwifi.com/192.168.31.1
# =====================================
[policy]
static=apple, direct, HK_auto, TW_auto, img-url=https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/icon/qure/Apple.png
static=google, US_auto, HK_auto, proxy, img-url=https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/icon/qure/Google.png
static=swiftgram, US_auto, HK_auto, proxy, img-url=https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/icon/qure/Telegram_X.png
static=spotify, HK_auto, TW_auto, proxy, img-url=https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/icon/qure/Spotify.png
static=openai, US_manual, proxy, img-url=https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Baidu_Cloud.png
url-latency-benchmark=HK_auto, server-tag-regex=港|HK|Hong|🇭🇰, check-interval=600, tolerance=0, alive-checking=false, img-url=https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/icon/qure/HK.png
url-latency-benchmark=TW_auto, server-tag-regex=台|TW|Taiwan, check-interval=600, tolerance=0, alive-checking=false, img-url=https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/icon/qure/TW.png
url-latency-benchmark=JP_auto, server-tag-regex=日|JP|Japan|🇯🇵, check-interval=600, tolerance=0, alive-checking=false, img-url=https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/icon/qure/JP.png
url-latency-benchmark=US_auto, server-tag-regex=美|US|States|American|🇺🇸, check-interval=600, tolerance=0, alive-checking=false, img-url=https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/icon/qure/US.png
url-latency-benchmark=SG_auto, server-tag-regex=新加坡|狮|獅|SG|🇸🇬, check-interval=600, tolerance=0, alive-checking=false, img-url=https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/icon/qure/SG.png
static=HK_manual, server-tag-regex=港|HK|Hong|🇭🇰, img-url=https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/icon/qure/HK.png
static=TW_manual, server-tag-regex=台|TW|Taiwan, img-url=https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/icon/qure/TW.png
static=JP_manual, server-tag-regex=日|JP|Japan|🇯🇵, img-url=https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/icon/qure/JP.png
static=US_manual, server-tag-regex=美|US|States|American|🇺🇸, img-url=https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/icon/qure/US.png
static=SG_manual, server-tag-regex=新加坡|狮|獅|SG|🇸🇬, img-url=https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/icon/qure/SG.png
