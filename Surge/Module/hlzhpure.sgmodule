#!name=hlzhpure
#!desc=umetrip ad blocking script
#!system=ios

[Rule]
# 简练功能说明：直接拦截广告素材服务器和统计接口
DOMAIN, analytics.umetrip.com, REJECT
URL-REGEX, ^https?:\/\/oss\.umetrip\.com\/fs\/advert\/, REJECT

[Script]
# 简练功能说明：处理初始化及首页混排广告
hlzh_pure = type=http-response,pattern=^https?:\/\/.*\.umetrip\.com\/gateway\/api\/umetrip\/(native|init),requires-body=1,binary-body-mode=1,script-path=https://raw.githubusercontent.com/axkrr/open_config/refs/heads/main/Surge/Module/hlzh.js

[MITM]
hostname = %APPEND% *.umetrip.com
