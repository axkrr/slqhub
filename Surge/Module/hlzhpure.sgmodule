#!name=hlzhpure
#!desc=umetrip ad blocking script
#!system=ios

[Rule]
# 简练功能说明：拦截第三方广告SDK及站内统计
DOMAIN, analytics.umetrip.com, REJECT
DOMAIN, adashbc.utdevice.apple.com, REJECT
DOMAIN, sdk.open.talk.com, REJECT
DOMAIN, amdc.m.taobao.com, REJECT
DOMAIN-SUFFIX, gdt.qq.com, REJECT
DOMAIN-SUFFIX, ad.umetrip.com, REJECT

# 简练功能说明：拦截核心广告素材，防止开屏及首页广告图加载
URL-REGEX, ^https?:\/\/oss\.umetrip\.com\/fs\/advert\/, REJECT
URL-REGEX, ^https?:\/\/static\.umetrip\.com\/fs\/advert\/, REJECT

# 简练功能说明：拦截广告专有配置接口（防止拉取广告位清单）
URL-REGEX, ^https?:\/\/.*\.umetrip\.com\/gateway\/api\/umetrip\/advert, REJECT

[Script]
# 简练功能说明：完全移除对 native/init 接口的 Body 修改，仅保留对第三方广告请求的拦截（可选）

[MITM]
hostname = %APPEND% *.umetrip.com, adashbc.utdevice.apple.com
