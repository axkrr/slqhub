#!name=去哒App开屏广告屏蔽(完美版)
#!desc=使用 JS 脚本劫持广告映射接口，实现零等待秒开。
#!system=ios

[Rule]
# 拦截图片素材，防止脚本失效时的兜底
DOMAIN-SUFFIX, myhuaweicloud.com, REJECT-TINYGIF
DOMAIN-SUFFIX, adkwai.com, REJECT
DOMAIN-SUFFIX, mobads.baidu.com, REJECT

[Script]
# 使用你提供的远程脚本路径，劫持广告逻辑
quda_ad_perfect = type=http-response, pattern=^https?:\/\/api\.shanghailingye\.cn\/ad\/map, requires-body=1, max-size=0, script-path=https://raw.githubusercontent.com/axkrr/slqhub/main/Surge/Module/Pure/qd_ad.js

[MITM]
# 必须包含广告域名
hostname = %APPEND% api.shanghailingye.cn, qudaapi.8quan.com
