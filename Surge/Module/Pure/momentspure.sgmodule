#!name= momentspure
#!desc= 微信朋友圈广告净化
#!category= 广告拦截

[Script]
# 微信朋友圈信息流 JSON 去广告
script-response-body ^https:\/\/(mp|sns)\.weixin\.qq\.com\/.*timeline script-path=https://raw.githubusercontent.com/axkrr/slqhub/main/Surge/Module/JS/momentspure.js, requires-body=true, timeout=10

[MITM]
hostname = %APPEND% mp.weixin.qq.com, sns.weixin.qq.com
