#!name=微信朋友圈广告净化
#!desc=过滤朋友圈广告及部分推广内容，由 axkrr 脚本提供支持。
#!category=广告拦截
#!system=ios

[Script]
# 微信朋友圈广告净化
微信朋友圈广告 = type=script-response-body,pattern=^https?:\/\/(mp|sns)\.weixin\.qq\.com\/.*timeline,requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/axkrr/slqhub/main/Surge/Module/JS/momentspure.js,timeout=10

[MITM]
hostname = %APPEND% mp.weixin.qq.com, sns.weixin.qq.com
