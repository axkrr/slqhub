#!name = qdpure
#!desc = 去哒 ad blocking script
#!category = 广告拦截
#!system = ios

[Script]
qdpure = type=http-response,pattern=^https?://api\.shanghailingye\.cn/ad/map,requires-body=1,max-size=0,script-path=Https://raw.githubusercontent.com/axkrr/open_config/refs/heads/main/Surge/Module/JS/qd.js

[MITM]
hostname = %APPEND% api.shanghailingye.cn
