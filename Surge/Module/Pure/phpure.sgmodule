#!name=PornHub 净化模块
#!desc=去除广告、注入净化 CSS。修复脚本空响应报错。
#!category=去广告

[Rule]
# 拒绝广告接口
URL-REGEX,^https?:\/\/(cn|www)\.pornhub\.com\/_xa\/ads,REJECT

[Script]
# 注入净化 CSS
phpure_js = type=http-response,pattern=^https?:\/\/(cn|www)\.pornhub\.com\/($|(view|video).*$),requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/axkrr/slqhub/main/Surge/Module/JS/phpure.js

[MITM]
hostname = %APPEND% cn.pornhub.com, www.pornhub.com
