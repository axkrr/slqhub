#!name=phpure
#!desc=PornHub净化
#!category=广告拦截
#!author=axkrr,ddgksf2013

[Rule]
# 拒绝广告接口
URL-REGEX,^https?:\/\/(cn|www)\.pornhub\.com\/_xa\/ads,REJECT

[Script]
pornhubpure=type=http-response,pattern=^https?://(cn|www)\.pornhub\.com/(?!(.*(api|login|cdn-cgi|verify|auth|captch|(\.(js|css|jpg|jpeg|png|webp|gif|zip|woff|woff2|m3u8|mp4|mov|m4v|avi|mkv|flv|rmvb|wmv|rm|asf|asx|mp3|json|ico|otf|ttf))))),requires-body=1,max-size=0,script-path=https://ddgksf2013.top/scripts/pornhub.ads.js

[MITM]
hostname = %APPEND% *.pornhub.com
