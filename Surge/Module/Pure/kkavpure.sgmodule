#!arguments=DOMAIN:kkavpure
#!arguments-desc=[参数设置]\nDOMAIN: 填入网站域名.com前面部分

[Rule]
DOMAIN-SUFFIX,akoot92.onting550.top,REJECT
DOMAIN-SUFFIX,beyond4099.top,REJECT
DOMAIN-SUFFIX,tjwqzz.com,REJECT
DOMAIN-SUFFIX,xyzinf113.top,REJECT
DOMAIN-SUFFIX,oline182.top,REJECT
DOMAIN-SUFFIX,86kg8j.com,REJECT
DOMAIN-SUFFIX,ccc333swrt.com,REJECT
DOMAIN-SUFFIX,hznunxc.com,REJECT
DOMAIN-SUFFIX,htst273h.com,REJECT
DOMAIN-SUFFIX,ah7907.com,REJECT
DOMAIN-SUFFIX,cpa-5qz4iogvmtll1w.com,REJECT
DOMAIN-SUFFIX,f3ns3tp.com,REJECT
DOMAIN-SUFFIX,ma5000.com,REJECT
DOMAIN-SUFFIX,fmjmm.com,REJECT
DOMAIN-SUFFIX,uwcng.com,REJECT
DOMAIN-SUFFIX,cospu2011.top,REJECT
DOMAIN-SUFFIX,cosman103.top,REJECT
DOMAIN-SUFFIX,cosman107.top,REJECT
# AWS CloudFront分发节点
DOMAIN,d84qwq8u30h53.cloudfront.net,REJECT
DOMAIN,dq38rjje7qjm3.cloudfront.net,REJECT
DOMAIN,d3ccefxs96519j.cloudfront.net,REJECT
# 阿里CDN
URL-REGEX,^https?:\/\/img\.alicdn\.com\/imgextra\/.*!!(2216598935604|2217565595682|2207246784654),REJECT
# 美团CDN
URL-REGEX,^https?:\/\/img\.meituan\.net\/content\/05d180f88068789c43d6ebd62be843a4181000\.gif,REJECT
# 屏蔽广告占位图
URL-REGEX,^https?:\/\/{{{DOMAIN}}}\.com\/images\/placeholder2\.png,REJECT

[Script]
kkavpure = type=http-response,pattern=aaCoverAd\.js,requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/axkrr/slqhub-entry/main/kkavpure.js

kkavcss = type=http-response,pattern=^https?:\/\/{{{DOMAIN}}}\.com,requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/axkrr/slqhub-entry/main/kkavcss.js

[MITM]
hostname = %APPEND% {{{DOMAIN}}}.com,*.{{{DOMAIN}}}.com