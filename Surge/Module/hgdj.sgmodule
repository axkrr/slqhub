[Script]
# 拦截账号信息接口，并交由指定脚本处理响应体
番茄短剧处理 = type=script-response-body,pattern=^http:\/\/8\.149\.129\.124:3002\/api\/account\/v1,requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/BOBOLAOSHIV587/Rules/main/JS/FanQieDuanJu/JS/FanQieDuanJu.js

[MITM]
# 必须包含该主机名才能解密流量
hostname = %APPEND% 8.149.129.124
