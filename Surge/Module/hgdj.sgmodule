[Script]
# 匹配番茄小说的核心 API
番茄小说解锁 = type=http-response,pattern=^https?:\/\/.*\.snssdk\.com\/(api\/ad\/v\d\/v2\/no_ad_pick|api\/app\/info\/v2\/get_info|api\/v\d\/user\/info),requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/WeiGiegie/666/main/fanqdj.js

[MITM]
hostname = %APPEND% *.snssdk.com, *.pangolin-sdk-toutiao.com
