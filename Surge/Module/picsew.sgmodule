#!name = pscrack
#!desc = picsew ad blocking script
#!system = ios

[Script]
# picsew 解锁脚本
pscrack_jsfile = type=http-response,pattern=^https:\/\/buy\.itunes\.apple\.com\/verifyReceipt,requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/89996462/Quantumult-X/main/ycdz/Picsew.js

[MITM]
hostname = %APPEND% buy.itunes.apple.com
