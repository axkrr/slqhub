#!name = qdpure
#!desc = quda ad blocking script
#!system = ios

[Script]
# 开屏广告请求拦截
qdpure = type=http-response,pattern=^https?://api\.shanghailingye\.cn/ad/map,requires-body=1,max-size=0,script-path=Https://raw.githubusercontent.com/axkrr/open_config/refs/heads/main/Surge/Module/qd.js

[MITM]
hostname = %APPEND% api.shanghailingye.cn
