#!name=视频流获取跳转 SenPlayer
#!desc=移植自 Tampermonkey 原版内核。自动嗅探 m3u8，点击 Surge 通知直接跳转 SenPlayer 播放。
#!category=工具类

[Script]
# 注入与信号处理，主要针对 PH 和 TXH
Video_Sniff = type=http-response,pattern=^https?:\/\/(www|cn|m)\.(pornhub|txh067)\.com\/,requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/axkrr/slqhub/main/Surge/Module/JS/m3u8extractor.js

[MITM]
# 必须解密这两个域名及其子域名
hostname = %APPEND% *.pornhub.com, *.txh067.com
