#!name=视频提取跳转 SenPlayer (PH & TXH)
#!desc=在senplayer播放。
#!category=工具模块

[Script]
# 确保 pattern 覆盖了两个域名，并且开启了 body 获取
VideoSniff = type=http-response,pattern=^https?:\/\/(www|cn|m)\.(pornhub|txh067)\.com\/,requires-body=1,script-path=https://raw.githubusercontent.com/axkrr/slqhub/main/Surge/Module/JS/m3u8extractor.js

[MITM]
hostname = %APPEND% *.pornhub.com, *.txh067.com

