#!name=重庆大学饭卡余额
#!desc=获取重庆大学一卡通饭卡 Cookie
#!category=组件服务
#!author=Hermes
 
[Script]
饭卡Cookie = type=http-request, pattern=http:\/\/card\.cqu\.edu\.cn\/NcAccType\/GetCurrentAccountList, script-path=https://raw.githubusercontent.com/axkrr/slqhub-entry/main/cardbalance.js, requires-body=1, max-size=0, script-update-interval=0
 
[MITM]
hostname = %APPEND% card.cqu.edu.cn